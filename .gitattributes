# Normalize text files to LF in the repository, regardless of platform.
# This avoids noisy diffs and CRLF/LF conversion warnings on Windows.

* text=auto

# Source code
*.py   text eol=lf
*.c    text eol=lf
*.cc   text eol=lf
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf

# Scripts
*.sh   text eol=lf
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Config / docs
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf
*.txt  text eol=lf

# Binary-like artifacts (never modify line endings)
*.pt   -text
*.pth  -text
*.npz  -text
*.npy  -text
*.onnx -text
*.pdf  -text
*.dot  -text

